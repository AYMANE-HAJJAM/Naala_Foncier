generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RiskLevel {
  CRITIQUE
  ELEVE_CRITIQUE
  ELEVE
  MOYEN
  FAIBLE
  A_CONFIRMER
  CRITIQUE_OPERATIONNEL
}

enum RequisitionStatus {
  EN_COURS
  AU_TRIBUNAL
  AUDIENCE_PROGRAMMEE
  DELIBERE
  BORNAGE_BLOQUE
  DOCUMENTS_INCOMPLETS
  ACTION_REQUISE
  A_CONFIRMER
  CLOTURE
}

enum DocumentCategory {
  FICHE_SYNTHESE
  ANCFCC
  ACTES
  ACTES_PROPRIETE
  OPPOSITIONS
  TRIBUNAL
  TOPOGRAPHIE
  TERRAIN
  CORRESPONDANCES
  RAPPORTS
  AUTRE
}

enum TerrainEventType {
  GENERAL_UPDATE
  COURT_TRANSMISSION
  COURT_CASE_CREATED
  COURT_HEARING_SCHEDULED
  COURT_HEARING_POSTPONED
  COURT_HEARING_HELD
  COURT_DELIBERATION
  COURT_DECISION
  COURT_APPEAL
  COURT_CLOSED
  COURT_OTHER
  BORNAGE_SCHEDULED
  BORNAGE_ATTEMPTED
  BORNAGE_BLOCKED
  BORNAGE_COMPLETED
  OPPOSITION_ADDED
  OPPOSITION_UPDATED
  DOCUMENT_RECEIVED
  ANCFCC_STATUS_UPDATED
  OTHER
}

enum TerrainEventSource {
  MANUAL
  DOCUMENT
  AI_PROPOSAL
  IMPORT
  SYSTEM
  HEARING_MIRROR
}

enum TerrainEventValidationStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum DataFreshnessCode {
  CONFIRMED
  TO_CONFIRM
  OUTDATED
  AI_SUGGESTED
}

enum AIExtractionStatus {
  PROPOSED
  CONFIRMED
  REJECTED
  SUPERSEDED
}

enum TerrainDraftStatus {
  DRAFT
  ANALYZING
  READY_FOR_REVIEW
  CONFIRMED
  CANCELLED
}

enum AIAnalysisRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  STALE
  NO_CHANGE
}

enum AIAnalysisContextType {
  TERRAIN_CREATION
  EXISTING_TERRAIN_UPDATE
}

enum DocumentStatus {
  DISPONIBLE
  MANQUANT
  INCOMPLET
  ILLISIBLE
  A_ACTUALISER
  VALIDE
}

enum DocumentConfidentiality {
  INTERNE
  CONFIDENTIEL
  RESTREINT
}

enum DocumentVisibility {
  PARTAGE
  INTERNE
}

enum CourtStage {
  NON_TRANSMIS
  TRANSMISSION_EN_COURS
  TRANSMIS_AU_TRIBUNAL
  ENREGISTRE_AU_TRIBUNAL
  EN_ATTENTE_AUDIENCE
  AUDIENCE_PROGRAMMEE
  AUDIENCE_TENUE
  REPORTE
  MEMOIRE_A_DEPOSER
  EN_DELIBERE
  DECISION_RENDUE
  APPEL_EN_COURS
  CLOTURE
  A_CONFIRMER
}

enum ReportScope {
  REQUISITION
  PORTFOLIO
}

enum SourceQuality {
  BONNE
  MOYENNE
  FAIBLE
}

enum DocumentRequestPriority {
  URGENTE
  HAUTE
  NORMALE
  FAIBLE
}

enum DocumentRequestStatus {
  A_DEMANDER
  DEMANDE
  RELANCE
  RECU
  ANNULE
}

enum OppositionIdentityStatus {
  DEMONSTRATION_NON_VERIFIEE
  A_CONFIRMER
  VERIFIEE
}

enum OppositionType {
  TOTALE
  PARTIELLE
  DROITS_INDIVIS
  SERVITUDE
  INSTITUTIONNELLE
  ISSUE_DU_BORNAGE
  HORS_DELAI
  A_QUALIFIER
  OTHER
}

enum OppositionStrategy {
  CONTESTER
  NEGOCIER
  ISOLER
  REGULARISER
  ANALYSER
  DEMANDER_DES_PIECES
}

enum HearingEventType {
  DEPOT
  AUDIENCE
  REPORT
  MEMOIRE_DEPOSE
  MOUDAWALA
  JUGEMENT
  APPEL
  BORNAGE
  RELANCE
  REUNION
  ECHEANCE_DOCUMENTAIRE
}

enum HearingStatus {
  PLANIFIE
  REALISE
  SUIVI_REQUIS
  ANNULE
  REPORTE
  A_CONFIRMER
}

enum ActionCategory {
  JURIDIQUE
  ANCFCC
  TOPOGRAPHIE
  TERRAIN
  DOCUMENTATION
  COORDINATION
}

enum ActionPriority {
  URGENTE
  HAUTE
  NORMALE
  FAIBLE
}

enum ActionStatus {
  A_FAIRE
  EN_COURS
  EN_ATTENTE
  BLOQUEE
  TERMINEE
}

enum ReportStatus {
  BROUILLON
  A_VALIDER
  VALIDE
  PUBLIE
  REJETE
  ARCHIVE
}

enum AIJobStatus {
  EN_ATTENTE
  EN_COURS
  TERMINEE
  ECHEC
  PROVIDER_NON_CONFIGURE
}

enum HumanValidationStatus {
  NON_COMMENCEE
  A_VALIDER
  PARTIELLE
  VALIDEE
}

enum DocumentAnalysisStatus {
  EN_ATTENTE
  EN_COURS
  TERMINEE
  ECHEC
}

enum FactConfidence {
  ELEVEE
  MOYENNE
  FAIBLE
}

enum FactValidationStatus {
  A_VERIFIER
  CONFIRME
  CORRIGE
  REJETE
}

enum UploadSessionStatus {
  CREATED
  UPLOADED
  COMPLETED
  EXPIRED
  CANCELLED
}

model User {
  id                       String                  @id @default(uuid()) @db.Uuid
  firstName                String
  lastName                 String
  email                    String                  @unique
  passwordHash             String
  phone                    String?
  isActive                 Boolean                 @default(true)
  lastLoginAt              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  deletedAt                DateTime?
  roles                    UserRole[]
  refreshTokens            RefreshToken[]
  responsibleRequisitions  Requisition[]           @relation("ResponsibleRequisitions")
  createdRequisitions      Requisition[]           @relation("CreatedRequisitions")
  updatedRequisitions      Requisition[]           @relation("UpdatedRequisitions")
  createdDocuments         Document[]              @relation("CreatedDocuments")
  validatedDocuments       Document[]              @relation("ValidatedDocuments")
  uploadedVersions         DocumentVersion[]
  assignedDocumentRequests DocumentRequest[]
  responsibleOppositions   Opposition[]
  legalCases               LegalCase[]
  responsibleHearings      Hearing[]
  createdHearings          Hearing[]               @relation("CreatedHearings")
  createdActions           ActionItem[]            @relation("CreatedActions")
  responsibleActions       ActionItem[]            @relation("ResponsibleActions")
  actionComments           ActionComment[]
  notifications            Notification[]
  notificationReminders    NotificationReminder[]
  createdReports           Report[]                @relation("CreatedReports")
  validatedReports         Report[]                @relation("ValidatedReports")
  publishedReports         Report[]                @relation("PublishedReports")
  requestedAnalyses        AIAnalysisJob[]
  validatedFacts           ExtractedFact[]
  auditLogs                AuditLog[]
  uploadSessions           UploadSession[]
  requisitionAccess        UserRequisitionAccess[] @relation("UserRequisitionAccessUser")
  grantedRequisitionAccess UserRequisitionAccess[] @relation("UserRequisitionAccessGrantedBy")
  createdTerrainEvents     TerrainEvent[]          @relation("TerrainEventCreatedBy")
  validatedTerrainEvents   TerrainEvent[]          @relation("TerrainEventValidatedBy")
  createdTerrainDrafts     TerrainDraft[]
  reviewedAIExtractions    AIExtraction[]          @relation("AIExtractionReviewedBy")
  createdAIExtractions     AIExtraction[]          @relation("AIExtractionCreatedBy")

  @@index([isActive, deletedAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  name  String
  roles RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  familyId          String    @db.Uuid
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @db.Uuid
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt, revokedAt])
}

model Requisition {
  id                    String                     @id @default(uuid()) @db.Uuid
  reference             String                     @unique
  propertyName          String
  location              String
  province              String
  surfaceHectares       Int
  surfaceAres           Int
  surfaceCentiares      Int
  sellerName            String
  buyerName             String
  riskLevel             RiskLevel
  mainStatus            RequisitionStatus
  mainStatusLabel       String?
  mainIssue             String
  summary               String?
  currentSituation      String?
  constraintsJson       Json?
  resolutionStepsJson   Json?
  pointsToClarifyJson   Json?
  latestKnownEvent      String?
  latestKnownEventAt    DateTime?
  eventResult           String?
  latestJudicialEvent   String?
  latestJudicialEventAt DateTime?
  judicialResult        String?
  nextScheduledEventAt  DateTime?
  courtReached          String?
  dataFreshness         String?
  summarySourceMeta     Json?
  lastManuallyUpdatedAt DateTime?
  oppositionCount       Int?
  nextAction            String?
  criticalDetails       Json?
  priorityRank          Int?
  importantDate         DateTime?
  eventLabel            String?
  isPrincipal           Boolean                    @default(true)
  responsibleUserId     String?                    @db.Uuid
  createdById           String                     @db.Uuid
  lastUpdatedById       String                     @db.Uuid
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  deletedAt             DateTime?
  responsibleUser       User?                      @relation("ResponsibleRequisitions", fields: [responsibleUserId], references: [id])
  createdBy             User                       @relation("CreatedRequisitions", fields: [createdById], references: [id])
  lastUpdatedBy         User                       @relation("UpdatedRequisitions", fields: [lastUpdatedById], references: [id])
  outgoingRelations     RequisitionRelation[]      @relation("RelationSource")
  incomingRelations     RequisitionRelation[]      @relation("RelationTarget")
  documents             Document[]
  documentRequests      DocumentRequest[]
  oppositions           Opposition[]
  legalCases            LegalCase[]
  hearings              Hearing[]
  actions               ActionItem[]
  notifications         Notification[]
  reports               Report[]
  aiAnalysisJobs        AIAnalysisJob[]
  uploadSessions        UploadSession[]
  userAccess            UserRequisitionAccess[]
  terrainEvents         TerrainEvent[]
  statusSnapshot        RequisitionStatusSnapshot?
  aiExtractions         AIExtraction[]
  linkedLegalCases      LegalCase[]                @relation("LegalCaseLinkedRequisition")
  aiAnalysisRuns        AIAnalysisRun[]

  @@index([riskLevel, mainStatus])
  @@index([location])
  @@index([buyerName])
  @@index([deletedAt])
  @@index([isPrincipal])
}

model UserRequisitionAccess {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  requisitionId String      @db.Uuid
  createdAt     DateTime    @default(now())
  createdById   String      @db.Uuid
  user          User        @relation("UserRequisitionAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  createdBy     User        @relation("UserRequisitionAccessGrantedBy", fields: [createdById], references: [id])

  @@unique([userId, requisitionId])
  @@index([requisitionId])
  @@index([userId])
}

model RequisitionRelation {
  id                  String      @id @default(uuid()) @db.Uuid
  sourceRequisitionId String      @db.Uuid
  targetRequisitionId String      @db.Uuid
  relationType        String
  description         String?
  source              Requisition @relation("RelationSource", fields: [sourceRequisitionId], references: [id], onDelete: Cascade)
  target              Requisition @relation("RelationTarget", fields: [targetRequisitionId], references: [id], onDelete: Cascade)

  @@unique([sourceRequisitionId, targetRequisitionId, relationType])
}

model Document {
  id                 String                  @id @default(uuid()) @db.Uuid
  requisitionId      String                  @db.Uuid
  title              String
  category           DocumentCategory
  /// Terrain-specific label when category = AUTRE (not a global taxonomy entry).
  customCategoryName String?
  status             DocumentStatus
  confidentiality    DocumentConfidentiality @default(INTERNE)
  visibility         DocumentVisibility      @default(PARTAGE)
  documentDate       DateTime?
  description        String?
  currentVersionId   String?                 @unique @db.Uuid
  createdById        String                  @db.Uuid
  validatedById      String?                 @db.Uuid
  validatedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?
  requisition        Requisition             @relation(fields: [requisitionId], references: [id])
  createdBy          User                    @relation("CreatedDocuments", fields: [createdById], references: [id])
  validatedBy        User?                   @relation("ValidatedDocuments", fields: [validatedById], references: [id])
  currentVersion     DocumentVersion?        @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions           DocumentVersion[]       @relation("DocumentVersions")
  requests           DocumentRequest[]
  oppositionLinks    OppositionDocument[]
  oppositionSources  Opposition[]            @relation("OppositionSourceDocument")
  hearingMinutes     Hearing[]
  reports            Report[]                @relation("ReportSourceDocument")
  previewReports     Report[]                @relation("ReportPreviewDocument")
  terrainEvents      TerrainEvent[]
  aiExtractions      AIExtraction[]
  aiAnalysisRuns     AIAnalysisRun[]

  @@index([requisitionId, category, status])
  @@index([requisitionId, visibility])
  @@index([deletedAt])
}

model DocumentVersion {
  id                     String               @id @default(uuid()) @db.Uuid
  documentId             String               @db.Uuid
  versionNumber          Int
  storageProvider        String
  storageBucket          String
  storageKey             String               @unique
  originalFilename       String
  mimeType               String
  sizeBytes              BigInt
  sha256Checksum         String?
  pageCount              Int?
  sourceQuality          SourceQuality        @default(MOYENNE)
  uploadedById           String               @db.Uuid
  uploadedAt             DateTime             @default(now())
  notes                  String?
  cloudinaryPublicId     String?
  cloudinaryAssetId      String?
  cloudinaryVersion      String?
  cloudinaryResourceType String?
  cloudinaryDeliveryType String?
  format                 String?
  width                  Int?
  height                 Int?
  document               Document             @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor             Document?            @relation("CurrentDocumentVersion")
  uploadedBy             User                 @relation(fields: [uploadedById], references: [id])
  aiJobs                 AIAnalysisDocument[]
  analyses               DocumentAnalysis[]

  @@unique([documentId, versionNumber])
}

model DocumentRequest {
  id                     String                  @id @default(uuid()) @db.Uuid
  requisitionId          String                  @db.Uuid
  documentId             String?                 @db.Uuid
  requestedDocumentTitle String
  category               DocumentCategory
  priority               DocumentRequestPriority
  status                 DocumentRequestStatus
  requestedFrom          String?
  assignedToId           String?                 @db.Uuid
  requestedAt            DateTime                @default(now())
  dueDate                DateTime?
  completedAt            DateTime?
  notes                  String?
  requisition            Requisition             @relation(fields: [requisitionId], references: [id])
  document               Document?               @relation(fields: [documentId], references: [id])
  assignedTo             User?                   @relation(fields: [assignedToId], references: [id])

  @@index([status, dueDate])
  @@index([requisitionId, priority])
}

model Opposition {
  id                      String                   @id @default(uuid()) @db.Uuid
  requisitionId           String                   @db.Uuid
  oppositionNumber        Int?
  opponentName            String?
  identityStatus          OppositionIdentityStatus @default(A_CONFIRMER)
  type                    OppositionType
  scope                   String?
  claimedSurfaceHectares  Int?
  claimedSurfaceAres      Int?
  claimedSurfaceCentiares Int?
  legalBasis              String?
  description             String?
  ancfccStatus            String?
  courtStatus             String?
  riskLevel               RiskLevel?
  strategy                OppositionStrategy?
  responsibleUserId       String?                  @db.Uuid
  referenceDate           DateTime?
  impact                  String?
  notes                   String?
  sourceDocumentId        String?                  @db.Uuid
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  requisition             Requisition              @relation(fields: [requisitionId], references: [id])
  responsibleUser         User?                    @relation(fields: [responsibleUserId], references: [id])
  sourceDocument          Document?                @relation("OppositionSourceDocument", fields: [sourceDocumentId], references: [id])
  documents               OppositionDocument[]

  @@unique([requisitionId, oppositionNumber])
  @@index([type, riskLevel])
  @@index([deletedAt])
}

model OppositionDocument {
  oppositionId String     @db.Uuid
  documentId   String     @db.Uuid
  opposition   Opposition @relation(fields: [oppositionId], references: [id], onDelete: Cascade)
  document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([oppositionId, documentId])
}

model LegalCase {
  id                  String       @id @default(uuid()) @db.Uuid
  requisitionId       String       @db.Uuid
  caseNumber          String       @unique
  courtName           String
  courtCity           String?
  caseType            String
  currentPhase        String
  currentStage        CourtStage   @default(A_CONFIRMER)
  currentStatus       String?
  registrationDate    DateTime?
  lawyerUserId        String?      @db.Uuid
  opposingParties     String
  outcomeStatus       String?
  latestEventAt       DateTime?
  nextEventAt         DateTime?
  generalObservation  String?
  notes               String?
  /// Optional linked requisition (e.g. R 16605 ↔ R 20612 reciprocal cases)
  linkedRequisitionId String?      @db.Uuid
  externalSource      String?
  externalReference   String?
  externalUrl         String?
  lastExternalCheckAt DateTime?
  externalPayloadHash String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  requisition         Requisition  @relation(fields: [requisitionId], references: [id])
  linkedRequisition   Requisition? @relation("LegalCaseLinkedRequisition", fields: [linkedRequisitionId], references: [id])
  lawyer              User?        @relation(fields: [lawyerUserId], references: [id])
  hearings            Hearing[]

  @@index([currentPhase, nextEventAt])
  @@index([currentStage, nextEventAt])
  @@index([caseNumber])
  @@index([linkedRequisitionId])
  @@index([deletedAt])
}

model Hearing {
  id                String                 @id @default(uuid()) @db.Uuid
  legalCaseId       String?                @db.Uuid
  requisitionId     String                 @db.Uuid
  eventType         HearingEventType
  title             String
  description       String?
  scheduledAt       DateTime?
  completedAt       DateTime?
  status            HearingStatus
  result            String?
  nextAction        String?
  nextDate          DateTime?
  visibility        DocumentVisibility     @default(PARTAGE)
  minutesDocumentId String?                @db.Uuid
  responsibleUserId String?                @db.Uuid
  createdById       String?                @db.Uuid
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  legalCase         LegalCase?             @relation(fields: [legalCaseId], references: [id])
  requisition       Requisition            @relation(fields: [requisitionId], references: [id])
  minutesDocument   Document?              @relation(fields: [minutesDocumentId], references: [id])
  responsibleUser   User?                  @relation(fields: [responsibleUserId], references: [id])
  createdBy         User?                  @relation("CreatedHearings", fields: [createdById], references: [id])
  reminders         NotificationReminder[]

  @@index([scheduledAt, status])
  @@index([nextDate, status])
  @@index([requisitionId, eventType])
}

model ActionItem {
  id                String          @id @default(uuid()) @db.Uuid
  requisitionId     String?         @db.Uuid
  title             String
  description       String?
  category          ActionCategory
  priority          ActionPriority
  status            ActionStatus    @default(A_FAIRE)
  responsibleUserId String?         @db.Uuid
  createdById       String          @db.Uuid
  dueDate           DateTime?
  completedAt       DateTime?
  progress          Int             @default(0)
  blockage          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  requisition       Requisition?    @relation(fields: [requisitionId], references: [id])
  responsibleUser   User?           @relation("ResponsibleActions", fields: [responsibleUserId], references: [id])
  createdBy         User            @relation("CreatedActions", fields: [createdById], references: [id])
  comments          ActionComment[]

  @@index([status, dueDate])
  @@index([responsibleUserId, status])
  @@index([deletedAt])
}

model ActionComment {
  id           String     @id @default(uuid()) @db.Uuid
  actionItemId String     @db.Uuid
  authorId     String     @db.Uuid
  content      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  actionItem   ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  author       User       @relation(fields: [authorId], references: [id])
}

model Notification {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  type              String
  title             String
  message           String
  requisitionId     String?      @db.Uuid
  relatedEntityType String?
  relatedEntityId   String?
  dedupeKey         String?      @unique
  readAt            DateTime?
  createdAt         DateTime     @default(now())
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  requisition       Requisition? @relation(fields: [requisitionId], references: [id])

  @@index([userId, readAt, createdAt])
}

model NotificationReminder {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  requisitionId String?   @db.Uuid
  hearingId     String?   @db.Uuid
  kind          String
  dueAt         DateTime
  sentAt        DateTime?
  emailSentAt   DateTime?
  dedupeKey     String    @unique
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hearing       Hearing?  @relation(fields: [hearingId], references: [id], onDelete: Cascade)

  @@index([dueAt, sentAt])
  @@index([userId, kind])
}

model Report {
  id                String          @id @default(uuid()) @db.Uuid
  requisitionId     String?         @db.Uuid
  scope             ReportScope     @default(REQUISITION)
  reportType        String
  title             String
  description       String?
  reportDate        DateTime?
  documentId        String?         @db.Uuid
  previewDocumentId String?         @db.Uuid
  status            ReportStatus    @default(BROUILLON)
  currentVersionId  String?         @unique @db.Uuid
  createdById       String          @db.Uuid
  validatedById     String?         @db.Uuid
  validatedAt       DateTime?
  publishedById     String?         @db.Uuid
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  requisition       Requisition?    @relation(fields: [requisitionId], references: [id])
  document          Document?       @relation("ReportSourceDocument", fields: [documentId], references: [id])
  previewDocument   Document?       @relation("ReportPreviewDocument", fields: [previewDocumentId], references: [id])
  currentVersion    ReportVersion?  @relation("CurrentReportVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions          ReportVersion[] @relation("ReportVersions")
  createdBy         User            @relation("CreatedReports", fields: [createdById], references: [id])
  validatedBy       User?           @relation("ValidatedReports", fields: [validatedById], references: [id])
  publishedBy       User?           @relation("PublishedReports", fields: [publishedById], references: [id])

  @@index([status, requisitionId])
  @@index([scope, requisitionId])
  @@index([deletedAt])
}

model ReportVersion {
  id            String   @id @default(uuid()) @db.Uuid
  reportId      String   @db.Uuid
  versionNumber Int
  contentJson   Json
  generatedBy   String
  sourceCount   Int
  generatedAt   DateTime @default(now())
  notes         String?
  report        Report   @relation("ReportVersions", fields: [reportId], references: [id], onDelete: Cascade)
  currentFor    Report?  @relation("CurrentReportVersion")

  @@unique([reportId, versionNumber])
}

model AIAnalysisJob {
  id                    String                @id @default(uuid()) @db.Uuid
  requisitionId         String                @db.Uuid
  status                AIJobStatus
  progress              Int                   @default(0)
  provider              String?
  model                 String?
  requestedById         String                @db.Uuid
  startedAt             DateTime?
  completedAt           DateTime?
  humanValidationStatus HumanValidationStatus @default(NON_COMMENCEE)
  errorMessage          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  requisition           Requisition           @relation(fields: [requisitionId], references: [id])
  requestedBy           User                  @relation(fields: [requestedById], references: [id])
  documents             AIAnalysisDocument[]

  @@index([status, createdAt])
}

model AIAnalysisDocument {
  aiAnalysisJobId   String          @db.Uuid
  documentVersionId String          @db.Uuid
  aiAnalysisJob     AIAnalysisJob   @relation(fields: [aiAnalysisJobId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@id([aiAnalysisJobId, documentVersionId])
}

model DocumentAnalysis {
  id                String                 @id @default(uuid()) @db.Uuid
  documentVersionId String                 @db.Uuid
  status            DocumentAnalysisStatus
  extractedText     String?
  provider          String?
  model             String?
  startedAt         DateTime?
  completedAt       DateTime?
  errorMessage      String?
  documentVersion   DocumentVersion        @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  facts             ExtractedFact[]
}

model ExtractedFact {
  id                 String               @id @default(uuid()) @db.Uuid
  documentAnalysisId String               @db.Uuid
  factType           String
  value              String
  normalizedValue    String?
  sourcePage         Int?
  confidence         FactConfidence
  validationStatus   FactValidationStatus @default(A_VERIFIER)
  correctedValue     String?
  validatedById      String?              @db.Uuid
  validatedAt        DateTime?
  documentAnalysis   DocumentAnalysis     @relation(fields: [documentAnalysisId], references: [id], onDelete: Cascade)
  validatedBy        User?                @relation(fields: [validatedById], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model UploadSession {
  id                 String              @id @default(uuid()) @db.Uuid
  requisitionId      String              @db.Uuid
  documentId         String?             @db.Uuid
  requestedById      String              @db.Uuid
  title              String
  category           DocumentCategory
  customCategoryName String?
  originalFilename   String
  mimeType           String
  sizeBytes          BigInt
  storageProvider    String
  storageBucket      String
  storageKey         String              @unique
  status             UploadSessionStatus @default(CREATED)
  expiresAt          DateTime
  createdAt          DateTime            @default(now())
  completedAt        DateTime?
  requisition        Requisition         @relation(fields: [requisitionId], references: [id])
  requestedBy        User                @relation(fields: [requestedById], references: [id])

  @@index([status, expiresAt])
}

/// Chronological terrain history — source of truth for evolving status (not identity).
model TerrainEvent {
  id                String                       @id @default(uuid()) @db.Uuid
  requisitionId     String                       @db.Uuid
  type              TerrainEventType
  occurredAt        DateTime
  title             String
  shortDescription  String?
  source            TerrainEventSource           @default(MANUAL)
  sourceDocumentId  String?                      @db.Uuid
  hearingId         String?                      @db.Uuid
  legalCaseId       String?                      @db.Uuid
  createdByUserId   String?                      @db.Uuid
  validatedByUserId String?                      @db.Uuid
  validationStatus  TerrainEventValidationStatus @default(CONFIRMED)
  isScheduled       Boolean                      @default(false)
  scheduledAt       DateTime?
  payloadJson       Json?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  requisition       Requisition                  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  sourceDocument    Document?                    @relation(fields: [sourceDocumentId], references: [id])
  createdBy         User?                        @relation("TerrainEventCreatedBy", fields: [createdByUserId], references: [id])
  validatedBy       User?                        @relation("TerrainEventValidatedBy", fields: [validatedByUserId], references: [id])

  @@index([requisitionId, occurredAt])
  @@index([requisitionId, validationStatus, occurredAt])
  @@index([scheduledAt, isScheduled])
  @@index([type])
}

/// Lightweight current-status projection updated from validated TerrainEvents.
model RequisitionStatusSnapshot {
  id                   String            @id @default(uuid()) @db.Uuid
  requisitionId        String            @unique @db.Uuid
  currentStage         String?
  currentLabel         String
  latestKnownEventId   String?           @db.Uuid
  latestKnownEventAt   DateTime?
  nextScheduledEventAt DateTime?
  judicialState        String?
  dataFreshness        DataFreshnessCode @default(TO_CONFIRM)
  lastVerifiedAt       DateTime?
  updatedAt            DateTime          @updatedAt
  createdAt            DateTime          @default(now())
  requisition          Requisition       @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([nextScheduledEventAt])
  @@index([dataFreshness])
}

/// AI proposals — never become official data without human confirmation.
model AIExtraction {
  id             String             @id @default(uuid()) @db.Uuid
  requisitionId  String?            @db.Uuid
  documentId     String?            @db.Uuid
  draftId        String?            @db.Uuid
  analysisRunId  String?            @db.Uuid
  extractionType String
  payloadJson    Json
  confidence     FactConfidence     @default(MOYENNE)
  status         AIExtractionStatus @default(PROPOSED)
  createdById    String?            @db.Uuid
  reviewedById   String?            @db.Uuid
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  requisition    Requisition?       @relation(fields: [requisitionId], references: [id])
  document       Document?          @relation(fields: [documentId], references: [id])
  draft          TerrainDraft?      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  analysisRun    AIAnalysisRun?     @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("AIExtractionCreatedBy", fields: [createdById], references: [id])
  reviewedBy     User?              @relation("AIExtractionReviewedBy", fields: [reviewedById], references: [id])

  @@index([requisitionId, status])
  @@index([draftId, status])
  @@index([documentId])
  @@index([analysisRunId, status])
}

/// Two-step terrain creation wizard (before Requisition exists).
model TerrainDraft {
  id                     String                 @id @default(uuid()) @db.Uuid
  createdById            String                 @db.Uuid
  status                 TerrainDraftStatus     @default(DRAFT)
  proposedIdentityJson   Json?
  proposedProceduralJson Json?
  proposedAnalysisJson   Json?
  analysisMessage        String?
  analysisFingerprint    String?
  latestAnalysisRunId    String?                @db.Uuid
  resultingRequisitionId String?                @db.Uuid
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  createdBy              User                   @relation(fields: [createdById], references: [id])
  documents              TerrainDraftDocument[]
  aiExtractions          AIExtraction[]
  analysisRuns           AIAnalysisRun[]

  @@index([createdById, status])
}

/// AI analysis run — wizard drafts and existing-terrain document updates.
model AIAnalysisRun {
  id                String                @id @default(uuid()) @db.Uuid
  contextType       AIAnalysisContextType @default(TERRAIN_CREATION)
  draftId           String?               @db.Uuid
  requisitionId     String?               @db.Uuid
  documentId        String?               @db.Uuid
  documentVersionId String?               @db.Uuid
  provider          String?
  model             String?
  status            AIAnalysisRunStatus   @default(PENDING)
  fingerprint       String
  phase             String?
  startedAt         DateTime?
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?
  resultJson        Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  draft             TerrainDraft?         @relation(fields: [draftId], references: [id], onDelete: Cascade)
  requisition       Requisition?          @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  document          Document?             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractions       AIExtraction[]

  @@index([draftId, status, createdAt])
  @@index([requisitionId, documentId, status, createdAt])
  @@index([fingerprint])
}

model TerrainDraftDocument {
  id                     String           @id @default(uuid()) @db.Uuid
  draftId                String           @db.Uuid
  category               DocumentCategory
  /// Terrain-specific label when category = AUTRE (not a global taxonomy entry).
  customCategoryName     String?
  title                  String
  originalFilename       String
  mimeType               String
  sizeBytes              BigInt
  documentDate           DateTime?
  storageProvider        String
  storageBucket          String
  storageKey             String           @unique
  cloudinaryPublicId     String?
  cloudinaryAssetId      String?
  cloudinaryResourceType String?
  cloudinaryDeliveryType String?
  format                 String?
  uploadedAt             DateTime         @default(now())
  draft                  TerrainDraft     @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, category])
}
