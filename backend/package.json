{
  "name": "naala-foncier-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:setup": "tsx scripts/set-primary-admin.ts",
    "db:generate": "npm run prisma:generate",
    "db:migrate": "npm run prisma:migrate",
    "db:migrate:deploy": "npm run prisma:migrate:deploy",
    "db:seed": "npm run prisma:seed",
    "import:sources": "tsx scripts/import-source-documents.ts",
    "import:sources:extract": "tsx scripts/import-source-documents.ts --extract-only",
    "import:sources:dry-run": "tsx scripts/import-source-documents.ts --dry-run",
    "import:assets:extract": "tsx scripts/import-source-documents.ts --extract-assets",
    "import:assets:dry-run": "tsx scripts/import-source-documents.ts --dry-run-documents",
    "import:assets:import": "tsx scripts/import-source-documents.ts --import-documents",
    "phase1:backfill": "tsx scripts/phase1-backfill.ts",
    "maintenance:smoke:phase2b-schema": "tsx scripts/verify-phase2b-schema.ts",
    "maintenance:cleanup:expired": "tsx scripts/cleanup-expired-work.ts",
    "maintenance:audit:phase-b-data": "tsx scripts/phase-b-data-quality.ts",
    "maintenance:refresh:phase-b-snapshots": "tsx scripts/refresh-phase-b-snapshots.ts",
    "qa:phase-c:setup": "tsx scripts/phase-c-qa-environment.ts setup",
    "qa:phase-c:diff": "tsx scripts/phase-c-qa-environment.ts diff",
    "qa:phase-c:cleanup": "tsx scripts/phase-c-qa-environment.ts cleanup --confirm-database=naala_phase_c_qa",
    "qa:phase-c:audit": "tsx scripts/phase-c-db-audit.ts --qa",
    "qa:phase-c:audit:main": "tsx scripts/phase-c-db-audit.ts",
    "qa:phase-c:cleanup-main:dry-run": "tsx scripts/phase-c-cleanup-main-fixtures.ts",
    "qa:phase-c:cleanup-main": "tsx scripts/phase-c-cleanup-main-fixtures.ts --confirm-test-fixtures",
    "qa:phase-c:cleanup-fixtures:dry-run": "tsx scripts/phase-c-cleanup-main-fixtures.ts --qa-database",
    "qa:phase-c:cleanup-fixtures": "tsx scripts/phase-c-cleanup-main-fixtures.ts --qa-database --confirm-test-fixtures"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.1",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.1",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-to-img": "^7.0.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "prisma": "^7.8.0"
  }
}
