* text=auto

*.sh text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.sql text eol=lf whitespace=-blank-at-eof
*.prisma text eol=lf
*.ps1 text eol=crlf

# Generated clients keep the formatter emitted by Prisma and Orval.
backend/src/generated/** whitespace=-blank-at-eol,-blank-at-eof
frontend/src/generated/** whitespace=-blank-at-eol,-blank-at-eof
